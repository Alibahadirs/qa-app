# Backend HTTP portu
PORT=3001

# SQLite veritabanı (geliştirme). Postgres'e geçerken bu satır değişir.
DATABASE_URL="file:./dev.db"
E2E_CHROMIUM_PATH=

# Takım parolası. Boş bırakılırsa kimlik doğrulama tamamen kapalıdır.
AUTH_PASSWORD=
# Oturum cookie'sini imzalayan anahtar. Üretimde mutlaka tanımlayın.
SESSION_SECRET=
