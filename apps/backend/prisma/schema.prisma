// Prisma 7 — bağlantı URL'i prisma.config.ts'te, runtime bağlantısı driver adapter ile.
// SQLite dizi tipini desteklemediği için steps/tags alanları JSON string olarak saklanır;
// dönüşüm src/lib/json.ts içinde tek yerde izole edilmiştir (Postgres'e geçişte orası değişir).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RunStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
}

enum ResultStatus {
  PASS
  FAIL
  BLOCKED
  SKIPPED
  NOT_RUN
}

enum ExecutionType {
  MANUAL
  AUTOMATED
}

model TestCase {
  id                   String   @id @default(cuid())
  title                String
  description          String?
  /// JSON string dizisi: ["adım 1", "adım 2"]
  steps                String   @default("[]")
  expectedResult       String
  priority             Priority @default(MEDIUM)
  /// JSON string dizisi: ["regression", "login"]
  tags                 String   @default("[]")
  isAutomatable        Boolean  @default(false)
  playwrightScriptPath String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  suites    TestSuiteCase[]
  results   TestResult[]
  scenarios Scenario[]

  @@index([priority])
  @@index([isAutomatable])
}

model TestSuite {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cases TestSuiteCase[]
  runs  TestRun[]
}

/// Suite ↔ Case ara tablosu; `order` suite içindeki sırayı tutar.
model TestSuiteCase {
  suiteId String
  caseId  String
  order   Int    @default(0)

  suite    TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  testCase TestCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@id([suiteId, caseId])
  @@index([suiteId, order])
}

model TestRun {
  id          String    @id @default(cuid())
  name        String
  suiteId     String
  status      RunStatus @default(IN_PROGRESS)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  suite   TestSuite    @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  results TestResult[]

  @@index([suiteId])
  @@index([status])
}

model TestResult {
  id     String @id @default(cuid())
  runId  String
  caseId String
  /// Run başlatılırken suite sırası burada dondurulur; suite sonradan
  /// yeniden sıralansa da geçmiş run'ların sırası değişmez.
  order  Int    @default(0)

  status         ResultStatus  @default(NOT_RUN)
  notes          String?
  screenshotPath String?
  executionType  ExecutionType @default(MANUAL)
  durationMs     Int?
  executedAt     DateTime      @default(now())

  run      TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([runId, caseId])
  @@index([runId, order])
  @@index([status])
}

/// Faz 7A — bir sayfada keşfedilen etkileşilebilir element ve onun sıralı aday seçicileri.
/// `key` deterministiktir: aynı sayfa yeniden kataloglandığında kayıt upsert edilir,
/// böylece senaryo adımlarının işaret ettiği element id'si sabit kalır.
model PageElement {
  id String @id @default(cuid())
  /// Katalog bir senaryoya bağlanabilir; bağlanmamış kayıtlar URL bazlı ortak katalogdur.
  scenarioId String?
  pageUrl    String
  key        String
  /// Kullanıcıya gösterilen ad (erişilebilir ad / etiket / metin).
  label   String
  role    String
  tagName String
  /// JSON dizisi: SelectorCandidate[] (bkz. src/lib/discovery/selectors.ts)
  candidateSelectors String
  discoveredAt       DateTime @default(now())
  updatedAt          DateTime @updatedAt

  scenario Scenario?      @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  steps    ScenarioStep[]

  @@unique([pageUrl, key])
  @@index([scenarioId])
}

/// Faz 7B — kodsuz senaryonun adım tipleri (CLAUDE.md Faz 7).
enum StepAction {
  GOTO
  CLICK
  TYPE
  SELECT
  WAIT
  ASSERT_TEXT
  ASSERT_VISIBLE
  ASSERT_NOT_VISIBLE
  ASSERT_URL
  ASSERT_VALUE
}

/// Arayüzden kurulan, kod içermeyen otomasyon senaryosu.
/// `playwrightScriptPath` ile yazılan senaryolar kaldırılmadı; bu ikinci yöntemdir.
model Scenario {
  id          String   @id @default(cuid())
  name        String
  description String?
  baseUrl     String
  /// Senaryo mevcut bir test case'e bağlanabilir (zorunlu değil).
  testCaseId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testCase  TestCase?           @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  steps     ScenarioStep[]
  elements  PageElement[]
  variables ScenarioVariable[]

  @@index([testCaseId])
}

/// Senaryonun tek bir adımı. Hedef element katalogdan gelir (PageElement).
/// WAIT adımının üç biçimi alan doluluğundan ayrılır:
///   target dolu → element görünür olana kadar, value dolu → URL içerene kadar,
///   yalnızca timeoutMs dolu → sabit süre.
model ScenarioStep {
  id              String     @id @default(cuid())
  scenarioId      String
  order           Int
  action          StepAction
  targetElementId String?
  value           String?
  timeoutMs       Int?

  scenario Scenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  target   PageElement? @relation(fields: [targetElementId], references: [id], onDelete: SetNull)

  @@index([scenarioId, order])
  @@index([targetElementId])
}

/// `{{degisken}}` değerleri. Parola gibi değerler senaryo metnine düz yazılmaz.
model ScenarioVariable {
  id         String  @id @default(cuid())
  scenarioId String
  name       String
  value      String
  /// true ise değer API yanıtlarında maskelenir.
  secret     Boolean @default(false)

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, name])
}
